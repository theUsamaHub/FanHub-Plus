# DB_HOST=ep-ancient-tree-azlzwguq.c-3.ap-southeast-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=neondb_owner
# DB_PASSWORD=your-neon-password

MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-email
MAIL_PASSWORD=your-password
MAIL_ENCRYPTION=tls

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Cloudflare R2 media storage (S3-compatible)
# Setup:
#   1. Cloudflare dashboard -> R2 -> Create bucket named exactly: fanhubplus
#   2. Bucket Settings -> Public Development URL -> copy https://pub-....r2.dev into R2_PUBLIC_URL
#   3. R2 -> Manage API tokens -> Create token with Object Read & Write on this bucket
#   4. Put Access Key ID / Secret into R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
#   5. Endpoint is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   6. Set MEDIA_DISK=r2 to upload media to R2 (use public for local disk)
# Never commit real keys. Never expose them to browser JS.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://f871307e7ae90996497566e06a03b88a.r2.cloudflarestorage.com
R2_BUCKET=fanhubplus
R2_PUBLIC_URL=https://pub-606d0225e6e8416f9e3667065db8d5fd.r2.dev
# Disk used for admin media uploads: public | r2
MEDIA_DISK=public

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Newsletter
NEWSLETTER_FROM_ADDRESS="newsletter@{{APP_DOMAIN}}"
NEWSLETTER_FROM_NAME="FanHubPlus Newsletter"
NEWSLETTER_UNSUBSCRIBE_URL="{{APP_URL}}/unsubscribe"
